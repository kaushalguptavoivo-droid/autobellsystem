<Window x:Class="AutoBellSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AutoBellSystem.ViewModels"
        Title="School Auto Bell System" Height="560" Width="900"
        WindowStartupLocation="CenterScreen"
        MinHeight="480" MinWidth="720">
    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModelRoot"/>
    </Window.DataContext>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="🔔 School Auto Bell System" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusText}" Foreground="Gray" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <!-- ==================== SCHEDULES TAB ==================== -->
            <TabItem Header="Schedules">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="+ Add Bell Period" Padding="12,6" Click="AddSchedule_Click"/>
                        <Button Content="Edit Selected" Padding="12,6" Margin="8,0,0,0" Click="EditSchedule_Click"/>
                        <Button Content="Delete Selected" Padding="12,6" Margin="8,0,0,0" Click="DeleteSchedule_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="SchedulesGrid" Grid.Row="1" ItemsSource="{Binding Schedules}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="70"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding BellTypeName}" Width="160"/>
                            <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}" Width="120"/>
                            <DataGridTextColumn Header="Rings" Binding="{Binding Rings}" Width="60"/>
                            <DataGridTextColumn Header="Days" Binding="{Binding DayOfWeek}" Width="140"/>
                            <DataGridTextColumn Header="Sound File" Binding="{Binding SoundFilePath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ==================== BLUETOOTH / SOUND TAB ==================== -->
            <TabItem Header="Bluetooth &amp; Sound">
                <StackPanel Margin="16" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="Playback Device" FontWeight="Bold" FontSize="14"/>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,10">
                        First pair your Bluetooth speaker in Windows Settings &gt; Bluetooth &amp; devices
                        (one-time setup). Once paired and turned on, it will show up below.
                        The app will send the bell sound directly to this speaker.
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox Width="320" ItemsSource="{Binding AvailableDevices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberPath="Name"/>
                        <Button Content="Refresh" Padding="10,4" Margin="8,0,0,0" Command="{Binding RefreshDevicesCommand}"/>
                    </StackPanel>
                    <Button Content="Set as Bell Speaker" Padding="10,4" HorizontalAlignment="Left"
                            Command="{Binding SaveDeviceChoiceCommand}" Margin="0,0,0,20"/>

                    <TextBlock Text="Volume" FontWeight="Bold" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <Slider x:Name="VolumeSlider" Width="280" Minimum="0" Maximum="100"
                                Value="{Binding Volume}" TickFrequency="10" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="{Binding Volume}" VerticalAlignment="Center" Margin="10,0,0,0" Width="30"/>
                    </StackPanel>
                    <Button Content="Save Volume" Padding="10,4" HorizontalAlignment="Left"
                            Command="{Binding SaveVolumeCommand}" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="🔔 Test Bell Now" Padding="12,6" Command="{Binding TestBellCommand}"/>
                        <Button Padding="12,6" Margin="10,0,0,0" Command="{Binding TogglePauseCommand}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Text" Value="▶ Resume Schedule"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="False">
                                                <Setter Property="Text" Value="⏸ Pause Schedule"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ==================== ABOUT TAB ==================== -->
            <TabItem Header="About">
                <StackPanel Margin="16" MaxWidth="520">
                    <TextBlock Text="School Auto Bell System" FontWeight="Bold" FontSize="16"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0">
                        • Runs fully offline - no internet connection is needed for scheduling or ringing bells.
                        • Starts automatically with Windows and keeps running quietly in the system tray.
                        • Closing this window does not stop the app - use the tray icon "Exit" to quit fully.
                        • Right-click the tray icon for Dashboard, Pause/Resume, and Test Bell options.
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
